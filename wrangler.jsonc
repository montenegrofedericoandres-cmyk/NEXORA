{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexora",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "preview_urls": false,
  "build": {
    "command": "python3 scripts/build_site.py"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
